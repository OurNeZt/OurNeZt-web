APP_ENV="development"
WEB_ADDR=":8080"
WEB_READ_HEADER_TIMEOUT="10s"
WEB_READ_TIMEOUT="15s"
WEB_WRITE_TIMEOUT="30s"
WEB_IDLE_TIMEOUT="60s"
WEB_MAX_REQUEST_BODY_BYTES="1048576"
CORE_GRPC_ADDR="localhost:50051"
SESSION_COOKIE_NAME="ournezt_session"
SESSION_COOKIE_MAX_AGE="12h"
SESSION_COOKIE_SECURE="false"
# Required in production: 32 random bytes encoded as 64 hex characters.
# Persist this secret and share it across all Web replicas. Empty is dev-only.
CSRF_AUTH_KEY=""
# Shared Core RPC budget per HTTP request; use a positive duration.
REQUEST_TIMEOUT="5s"
AUTH_IP_LIMIT="30"
AUTH_ACCOUNT_LIMIT="5"
AUTH_RATE_WINDOW="1m"
AUTH_MAX_CONCURRENT="8"
WEB_TRUSTED_PROXIES=""
MAINTENANCE_NOTICE_FILE=""
MAINTENANCE_NOTICE_ENABLED="false"
MAINTENANCE_NOTICE_LEVEL="warning"
MAINTENANCE_NOTICE_TITLE="Planned maintenance"
MAINTENANCE_NOTICE_MESSAGE="OurNeZt may be unavailable on 28 Jun 2026, 12:00 AM to approximately 2:00 AM SGT while we migrate ingress traffic."
MAINTENANCE_NOTICE_STARTS_AT="28 Jun 2026, 12:00 AM SGT"
MAINTENANCE_NOTICE_ENDS_AT="28 Jun 2026, approximately 2:00 AM SGT"
