{{ define "housing_compare" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title">Housing Comparison</h1>
    {{ if .Data.Families }}
    <form method="get" action="/housing/compare" class="flex gap-2 flex-wrap">
      <select class="select select-bordered" name="family_id">
        {{ range .Data.Families }}<option value="{{ .Id }}" {{ if eq $.Data.FamilyID .Id }}selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>
      <button class="btn btn-sm" type="submit">Switch</button>
    </form>
    {{ end }}
    {{ if .Data.FamilyID }}
    <a class="btn btn-sm mt-2" href="/housing?family_id={{ .Data.FamilyID }}">Back to Housing</a>
    {{ else }}
    <p>Select a family first from <a class="link" href="/dashboard">dashboard</a>.</p>
    {{ end }}
    <div class="grid gap-3 mt-3 md:hidden">
      {{ range .Data.Rows }}
      <section class="card border border-base-300 bg-base-100">
        <div class="card-body p-4">
          <h2 class="card-title text-lg">{{ .Name }}</h2>
          <div class="grid gap-3 mt-1">
            <div class="stat oz-stat-card bg-base-200 rounded-box">
              <div class="stat-title inline-flex items-center gap-1">Initial Payment{{ template "partials/help_tooltip" (dict "Key" "initial_downpayment_due_now" "Label" "Total Initial Payment Due Now") }}</div>
              <div class="stat-value oz-stat-value">{{ cents .TotalInitialPaymentCents }}</div>
            </div>
            <div class="stat oz-stat-card bg-base-200 rounded-box">
              <div class="stat-title inline-flex items-center gap-1">Downpayment + Fees{{ template "partials/help_tooltip" (dict "Key" "upfront_cost" "Label" "Downpayment + Fees") }}</div>
              <div class="stat-value oz-stat-value">{{ cents .Affordability.UpfrontCostCents }}</div>
            </div>
            <div class="stat oz-stat-card bg-base-200 rounded-box">
              <div class="stat-title">Mortgage</div>
              <div class="stat-value oz-stat-value">{{ cents .Affordability.MonthlyMortgageCents }}</div>
            </div>
            <div class="stat oz-stat-card bg-base-200 rounded-box">
              <div class="stat-title inline-flex items-center gap-1">Monthly Cost{{ template "partials/help_tooltip" (dict "Key" "monthly_housing_cost" "Label" "Monthly Housing Cost") }}</div>
              <div class="stat-value oz-stat-value">{{ cents .Affordability.MonthlyHousingCostCents }}</div>
            </div>
            <div class="stat oz-stat-card bg-base-200 rounded-box">
              <div class="stat-title inline-flex items-center gap-1">Surplus{{ template "partials/help_tooltip" (dict "Key" "monthly_surplus_after_housing" "Label" "Monthly Surplus After Housing") }}</div>
              <div class="stat-value oz-stat-value">{{ cents .Affordability.MonthlySurplusAfterHousingCents }}</div>
            </div>
          </div>
          <p class="mt-3 flex items-center gap-2 text-sm">
            <strong>Rating:</strong> {{ ratingLabel .Affordability.Rating }}
            {{ template "partials/help_tooltip" (dict "Key" "rating" "Label" "Affordability Rating") }}
          </p>
        </div>
      </section>
      {{ else }}
      <div class="alert oz-alert-soft text-sm">No comparison rows yet</div>
      {{ end }}
    </div>
    <div class="hidden md:block overflow-x-auto oz-comparison-scroll mt-3">
      <table class="table table-sm oz-table-compact oz-housing-compare-table whitespace-nowrap">
        <thead>
          <tr>
            <th><span class="hidden xl:inline">Option Name</span><span class="xl:hidden">Option</span></th>
            <th><span class="inline-flex items-center gap-1"><span class="hidden xl:inline">Initial Payment</span><span class="xl:hidden">Initial</span>{{ template "partials/help_tooltip" (dict "Key" "initial_downpayment_due_now" "Label" "Total Initial Payment Due Now") }}</span></th>
            <th><span class="inline-flex items-center gap-1"><span class="hidden xl:inline">Downpayment + Fees</span><span class="xl:hidden">D.P. + Fees</span>{{ template "partials/help_tooltip" (dict "Key" "upfront_cost" "Label" "Downpayment + Fees") }}</span></th>
            <th><span class="hidden xl:inline">Mortgage</span><span class="xl:hidden">Mtg.</span></th>
            <th><span class="inline-flex items-center gap-1"><span class="hidden xl:inline">Monthly Cost</span><span class="xl:hidden">Monthly</span>{{ template "partials/help_tooltip" (dict "Key" "monthly_housing_cost" "Label" "Monthly Housing Cost") }}</span></th>
            <th><span class="inline-flex items-center gap-1">Surplus{{ template "partials/help_tooltip" (dict "Key" "monthly_surplus_after_housing" "Label" "Monthly Surplus After Housing") }}</span></th>
            <th>
              <span class="inline-flex items-center gap-1">
                Rating
                {{ template "partials/help_tooltip" (dict "Key" "rating" "Label" "Affordability Rating") }}
              </span>
            </th>
          </tr>
        </thead>
        <tbody>
          {{ range .Data.Rows }}
          <tr>
            <td class="font-medium">{{ .Name }}</td>
            <td>{{ cents .TotalInitialPaymentCents }}</td>
            <td>{{ cents .Affordability.UpfrontCostCents }}</td>
            <td>{{ cents .Affordability.MonthlyMortgageCents }}</td>
            <td>{{ cents .Affordability.MonthlyHousingCostCents }}</td>
            <td>{{ cents .Affordability.MonthlySurplusAfterHousingCents }}</td>
            <td>{{ ratingLabel .Affordability.Rating }}</td>
          </tr>
          {{ else }}
          <tr><td colspan="7" class="opacity-70">No comparison rows yet</td></tr>
          {{ end }}
        </tbody>
      </table>
    </div>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
