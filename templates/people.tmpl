{{ define "people" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title">Household Profiles</h1>
    <p class="text-sm opacity-75">Account holders should edit their own financial profile from My Profile. Add/edit occupants here for household planning.</p>
    {{ if .Data.Families }}
    <form method="get" action="/people" class="flex gap-2 flex-wrap">
      <select class="select select-bordered" name="family_id">
        {{ range .Data.Families }}<option value="{{ .Id }}" {{ if eq $.Data.FamilyID .Id }}selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>
      <button class="btn btn-sm" type="submit">Switch</button>
    </form>
    {{ end }}
    {{ if .Data.FamilyID }}
    <div class="flex gap-2 mt-2">
      <a class="btn btn-primary btn-sm" href="/people/new?family_id={{ .Data.FamilyID }}">Add Occupant</a>
      <a class="btn btn-sm" href="/dashboard?family_id={{ .Data.FamilyID }}">Back to Dashboard</a>
    </div>
    {{ else }}
    <p>Select a family from <a class="link" href="/dashboard">dashboard</a>.</p>
    {{ end }}
    <div class="overflow-x-auto mt-3">
      <table class="table">
        <thead><tr><th>Name</th><th>Relationship</th><th>Status</th><th>Age</th><th>Income</th><th></th></tr></thead>
        <tbody>
          {{ range .Data.Rows }}
          <tr>
            <td>{{ .Person.Name }}</td>
            <td>{{ .Person.RelationshipLabel }}</td>
            <td>{{ .Person.EmploymentStatus }}</td>
            <td>{{ .Person.Age }}</td>
            <td>{{ cents .Person.GrossMonthlyIncomeCents }}</td>
            <td>
              {{ if .IsSelf }}
              <a class="btn btn-xs" href="/profile/person/{{ .Person.Id }}/edit">Edit in My Profile</a>
              {{ else }}
              <a class="btn btn-xs" href="/people/{{ .Person.Id }}/edit?family_id={{ $.Data.FamilyID }}">Edit</a>
              <form method="post" action="/people/{{ .Person.Id }}/delete" class="inline">
                <input type="hidden" name="family_id" value="{{ $.Data.FamilyID }}">
                <button class="btn btn-xs btn-error" type="submit">Delete</button>
              </form>
              {{ end }}
            </td>
          </tr>
          {{ else }}
          <tr><td colspan="6" class="opacity-70">No profiles yet</td></tr>
          {{ end }}
        </tbody>
      </table>
    </div>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
