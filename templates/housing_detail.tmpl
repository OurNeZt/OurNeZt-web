{{ define "housing_detail" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title">{{ .Data.Housing.Name }}</h1>
    <p>{{ .Data.Housing.HousingType }} at {{ .Data.Housing.Location }}</p>
    <div class="grid md:grid-cols-3 gap-3 mt-2">
      <div class="stat bg-base-200 rounded-box"><div class="stat-title">Purchase Price</div><div class="stat-value text-lg">{{ cents .Data.Housing.PurchasePriceCents }}</div></div>
      <div class="stat bg-base-200 rounded-box"><div class="stat-title">Loan Amount</div><div class="stat-value text-lg">{{ cents .Data.Housing.LoanAmountCents }}</div></div>
      <div class="stat bg-base-200 rounded-box"><div class="stat-title">Monthly Maintenance</div><div class="stat-value text-lg">{{ cents .Data.Housing.MonthlyMaintenanceCents }}</div></div>
    </div>
  </div>
</section>
<section class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <h2 class="card-title">Affordability Snapshot</h2>
    <div class="grid md:grid-cols-3 gap-3">
      <div class="stat bg-base-200 rounded-box"><div class="stat-title">Upfront Cost</div><div class="stat-value text-lg">{{ cents .Data.Affordability.UpfrontCostCents }}</div></div>
      <div class="stat bg-base-200 rounded-box"><div class="stat-title">Monthly Mortgage</div><div class="stat-value text-lg">{{ cents .Data.Affordability.MonthlyMortgageCents }}</div></div>
      <div class="stat bg-base-200 rounded-box"><div class="stat-title">Monthly Surplus After Housing</div><div class="stat-value text-lg">{{ cents .Data.Affordability.MonthlySurplusAfterHousingCents }}</div></div>
    </div>
    <p class="mt-3"><strong>Rating:</strong> {{ .Data.Affordability.Rating }}</p>
    <a class="btn btn-sm mt-3" href="/housing?family_id={{ .Data.FamilyID }}">Back</a>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
