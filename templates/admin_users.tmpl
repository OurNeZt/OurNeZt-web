{{ define "admin_users" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow mb-6">
  <div class="card-body">
    <h1 class="card-title text-3xl">All Users</h1>
    <p class="text-sm opacity-70">Admin operations for user lifecycle management using authenticated admin session.</p>
    <div class="stats stats-vertical md:stats-horizontal shadow mt-3">
      <div class="stat">
        <div class="stat-title">Total Users</div>
        <div class="stat-value text-xl">{{ .Data.TotalUsers }}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Active</div>
        <div class="stat-value text-xl">{{ .Data.ActiveUsers }}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Disabled</div>
        <div class="stat-value text-xl">{{ .Data.DisabledUsers }}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Admins</div>
        <div class="stat-value text-xl">{{ .Data.AdminUsers }}</div>
      </div>
      <div class="stat">
        <div class="stat-title">Must Change Password</div>
        <div class="stat-value text-xl">{{ .Data.MustChangePasswordUsers }}</div>
      </div>
    </div>
  </div>
</section>
<div class="grid gap-6 md:grid-cols-2">
  <section class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title">Create User</h2>
      <form method="post" action="/admin/users" class="space-y-2">
        <input class="input input-bordered w-full" name="email" placeholder="Email" required>
        <input class="input input-bordered w-full" name="display_name" placeholder="Display name" required>
        <input class="input input-bordered w-full" name="password" placeholder="Temporary password" required>
        <select class="select select-bordered w-full" name="role">
          <option value="user">user</option>
          <option value="admin">admin</option>
        </select>
        <button class="btn btn-primary" type="submit">Create user</button>
      </form>
    </div>
  </section>
  <section class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title">Disable User</h2>
      <p class="text-sm opacity-70">Paste the user ID to disable an account.</p>
      <form method="post" action="/admin/users/placeholder/disable" onsubmit="this.action='/admin/users/' + this.user_id.value + '/disable'" class="space-y-2">
        <input class="input input-bordered w-full" name="user_id" placeholder="User ID" required>
        <button class="btn btn-warning" type="submit">Disable user</button>
      </form>
      {{ with .Data.JustCreated }}
      <div class="alert alert-success mt-3">
        Created: {{ .DisplayName }} ({{ .Email }})<br>ID: {{ .Id }}
      </div>
      {{ end }}
    </div>
  </section>
</div>

<section class="card bg-base-100 shadow mt-6">
  <div class="card-body">
    <h2 class="card-title">User Table</h2>
    <div class="overflow-x-auto">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Display Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Password State</th>
            <th>User ID</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="adminUserTableBody">
          {{ range $index, $user := .Data.Users }}
          <tr data-admin-user-row{{ if ge $index 10 }} hidden{{ end }}>
            <td>{{ $user.DisplayName }}</td>
            <td>{{ $user.Email }}</td>
            <td>
              {{ if eq $user.Role "admin" }}
              <span class="badge badge-secondary">admin</span>
              {{ else }}
              <span class="badge badge-outline">user</span>
              {{ end }}
            </td>
            <td>
              {{ if $user.Disabled }}
              <span class="badge badge-error">disabled</span>
              {{ else }}
              <span class="badge badge-success">active</span>
              {{ end }}
            </td>
            <td>
              {{ if $user.MustChangePassword }}
              <span class="badge badge-warning">must change</span>
              {{ else }}
              <span class="badge badge-ghost">normal</span>
              {{ end }}
            </td>
            <td class="font-mono text-xs">{{ $user.Id }}</td>
            <td>
              {{ if $user.Disabled }}
              <span class="text-xs opacity-60">No action</span>
              {{ else if eq $user.Id $.Data.CurrentUserID }}
              <span class="text-xs opacity-60">Current admin</span>
              {{ else }}
              <form method="post" action="/admin/users/{{ $user.Id }}/disable" class="inline">
                <button class="btn btn-xs btn-warning" type="submit">Disable</button>
              </form>
              {{ end }}
            </td>
          </tr>
          {{ else }}
          <tr><td colspan="7" class="opacity-70">No users found</td></tr>
          {{ end }}
        </tbody>
      </table>
    </div>
    <div id="adminUserPagination" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" aria-label="User table pagination">
      <label class="flex shrink-0 items-center gap-2 text-sm" for="adminUserRowsPerPage">
        <span class="whitespace-nowrap">Rows per page</span>
        <select id="adminUserRowsPerPage" class="select select-bordered select-sm" aria-label="Rows per page" aria-controls="adminUserTableBody">
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </label>
      <div class="flex flex-wrap items-center gap-2">
        <span id="adminUserPageRange" class="text-sm opacity-70" aria-live="polite"></span>
        <div class="join">
          <button id="adminUserPreviousPage" class="btn btn-sm join-item" type="button" aria-controls="adminUserTableBody">Previous</button>
          <span id="adminUserPageIndicator" class="btn btn-sm join-item pointer-events-none" aria-live="polite"></span>
          <button id="adminUserNextPage" class="btn btn-sm join-item" type="button" aria-controls="adminUserTableBody">Next</button>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  (() => {
    const rows = Array.from(document.querySelectorAll("[data-admin-user-row]"));
    const rowsPerPageSelect = document.getElementById("adminUserRowsPerPage");
    const previousButton = document.getElementById("adminUserPreviousPage");
    const nextButton = document.getElementById("adminUserNextPage");
    const pageIndicator = document.getElementById("adminUserPageIndicator");
    const pageRange = document.getElementById("adminUserPageRange");

    if (!rowsPerPageSelect || !previousButton || !nextButton || !pageIndicator || !pageRange) return;

    let currentPage = 1;

    const renderPage = () => {
      const rowsPerPage = Number(rowsPerPageSelect.value);
      const totalPages = Math.max(1, Math.ceil(rows.length / rowsPerPage));
      currentPage = Math.min(Math.max(currentPage, 1), totalPages);

      const startIndex = (currentPage - 1) * rowsPerPage;
      const endIndex = Math.min(startIndex + rowsPerPage, rows.length);
      rows.forEach((row, index) => {
        row.hidden = index < startIndex || index >= endIndex;
      });

      previousButton.disabled = currentPage === 1;
      nextButton.disabled = currentPage === totalPages;
      pageIndicator.textContent = `Page ${currentPage} of ${totalPages}`;
      pageRange.textContent = rows.length === 0
        ? "No users"
        : `Showing ${startIndex + 1}-${endIndex} of ${rows.length}`;
    };

    previousButton.addEventListener("click", () => {
      currentPage -= 1;
      renderPage();
    });
    nextButton.addEventListener("click", () => {
      currentPage += 1;
      renderPage();
    });
    rowsPerPageSelect.addEventListener("change", () => {
      currentPage = 1;
      renderPage();
    });

    renderPage();
  })();
</script>
{{ template "partials/footer" . }}
{{ end }}
