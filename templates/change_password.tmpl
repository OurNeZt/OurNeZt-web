{{ define "change_password" }}
{{ template "partials/header" . }}
<section class="max-w-xl mx-auto mt-4 md:mt-8">
  <div class="card oz-panel">
    <div class="card-body">
      <h1 class="card-title text-2xl">
        {{ if .Data.IsAdmin }}Admin Password Update{{ else }}Change Password{{ end }}
      </h1>
      {{ if .Data.IsForced }}
      <div class="alert oz-alert-soft text-sm">
        Security setup required: update your password before continuing.
      </div>
      {{ else }}
      <p class="text-sm opacity-75">Update your password to keep your account secure.</p>
      {{ end }}

      <form method="post" action="/change-password" class="space-y-3 mt-2">
        <label class="oz-field">
          <span>Current password</span>
          <input class="input input-bordered w-full" type="password" name="current_password" autocomplete="current-password" required>
        </label>
        <label class="oz-field">
          <span>New password</span>
          <input class="input input-bordered w-full" type="password" name="new_password" autocomplete="new-password" required>
        </label>
        <label class="oz-field">
          <span>Confirm new password</span>
          <input class="input input-bordered w-full" type="password" name="confirm_new_password" autocomplete="new-password" required>
        </label>
        <button class="btn btn-primary w-full" type="submit">Update Password</button>
      </form>
    </div>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
