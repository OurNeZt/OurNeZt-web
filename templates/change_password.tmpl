{{ define "change_password" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow max-w-lg mx-auto mt-8">
  <div class="card-body">
    <h1 class="card-title">Change Password</h1>
    <p class="text-sm opacity-70">Your account requires a password update before continuing.</p>
    <form method="post" action="/change-password" class="space-y-3 mt-2">
      <label class="form-control">
        <span class="label-text">Current password</span>
        <input class="input input-bordered" type="password" name="current_password" required>
      </label>
      <label class="form-control">
        <span class="label-text">New password</span>
        <input class="input input-bordered" type="password" name="new_password" required>
      </label>
      <label class="form-control">
        <span class="label-text">Confirm new password</span>
        <input class="input input-bordered" type="password" name="confirm_new_password" required>
      </label>
      <button class="btn btn-primary w-full" type="submit">Update password</button>
    </form>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
