{{ define "housing" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title">Housing Options</h1>
    {{ if .Data.Families }}
    <form method="get" action="/housing" class="flex gap-2 flex-wrap">
      <select class="select select-bordered" name="family_id">
        {{ range .Data.Families }}<option value="{{ .Id }}" {{ if eq $.Data.FamilyID .Id }}selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>
      <button class="btn btn-sm" type="submit">Switch</button>
    </form>
    {{ end }}
    {{ if .Data.FamilyID }}
    <div class="flex gap-2 mt-2">
      <a class="btn btn-primary btn-sm" href="/housing/new?family_id={{ .Data.FamilyID }}">Add Housing Option</a>
      <a class="btn btn-sm" href="/housing/compare?family_id={{ .Data.FamilyID }}">Compare</a>
      <a class="btn btn-sm" href="/dashboard?family_id={{ .Data.FamilyID }}">Back to Dashboard</a>
    </div>
    {{ else }}
    <p>Select a family from <a class="link" href="/dashboard">dashboard</a>.</p>
    {{ end }}
    <div class="overflow-x-auto mt-3">
      <table class="table">
        <thead><tr><th>Name</th><th>Type</th><th>Price</th><th></th></tr></thead>
        <tbody>
          {{ range .Data.Housing }}
          <tr>
            <td>{{ .Name }}</td>
            <td>{{ .HousingType }}</td>
            <td>{{ cents .PurchasePriceCents }}</td>
            <td>
              <a class="btn btn-xs" href="/housing/{{ .Id }}?family_id={{ $.Data.FamilyID }}">View</a>
              <a class="btn btn-xs" href="/housing/{{ .Id }}/edit?family_id={{ $.Data.FamilyID }}">Edit</a>
              <form method="post" action="/housing/{{ .Id }}/delete" class="inline">
                <input type="hidden" name="family_id" value="{{ $.Data.FamilyID }}">
                <button class="btn btn-xs btn-error" type="submit">Delete</button>
              </form>
            </td>
          </tr>
          {{ else }}
          <tr><td colspan="4" class="opacity-70">No housing options yet</td></tr>
          {{ end }}
        </tbody>
      </table>
    </div>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
