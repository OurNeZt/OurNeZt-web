{{ define "housing_form" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow max-w-5xl mx-auto w-full">
  <div class="card-body">
    <h1 class="card-title">{{ if .Data.IsEdit }}Edit Housing{{ else }}Add Housing{{ end }}</h1>
    <p class="text-sm opacity-75">All money inputs are in dollars. Example: 1250.50 means $1,250.50.</p>
    <p class="text-xs opacity-70"><span class="text-error font-semibold">*</span> Required fields. Grant amount and buyer stamp duty are calculated automatically.</p>
    <form method="post" action="{{ if .Data.IsEdit }}/housing/{{ .Data.Housing.Id }}{{ else }}/housing{{ end }}" class="grid grid-cols-1 md:grid-cols-2 gap-3 oz-form-grid">
      <input type="hidden" name="family_id" value="{{ .Data.FamilyID }}">
      <div class="oz-field">
        <label class="oz-field-label" for="assessment_mode"><span class="inline-flex items-center gap-1">Assessment Mode<span class="text-error" aria-label="required" title="Required">*</span>{{ template "partials/help_tooltip" (dict "Key" "assessment_mode" "Label" "Assessment Mode") }}</span></label>
        <select class="select select-bordered w-full" name="assessment_mode" id="assessment_mode" required>
          <option value="standard" {{ if eqFold .Data.AssessmentMode "standard" }}selected{{ end }}>Standard</option>
          <option value="deferred" {{ if eqFold .Data.AssessmentMode "deferred" }}selected{{ end }}>Deferred Income Assessment (DIA)</option>
        </select>
      </div>
      <label class="oz-field">
        <span>Option Name <span class="text-error" aria-label="required" title="Required">*</span></span>
        <input class="input input-bordered" name="name" placeholder="e.g. Tengah BTO 4-Room" value="{{ .Data.Housing.Name }}" required>
      </label>
      <label class="oz-field">
        <span>Housing Type <span class="text-error" aria-label="required" title="Required">*</span></span>
        <select class="select select-bordered w-full" id="housing_type" name="housing_type" required>
          <option value="" {{ if eq .Data.Housing.HousingType "" }}selected{{ end }}>Select housing type</option>
          <option value="bto" {{ if eqFold .Data.Housing.HousingType "bto" }}selected{{ end }}>BTO</option>
          <option value="resale_hdb" {{ if eqFold .Data.Housing.HousingType "resale_hdb" }}selected{{ end }}>Resale HDB</option>
          <option value="executive_condo" {{ if eqFold .Data.Housing.HousingType "executive_condo" }}selected{{ end }}>Executive Condo</option>
          <option value="private_condo" {{ if eqFold .Data.Housing.HousingType "private_condo" }}selected{{ end }}>Private Condo</option>
          <option value="landed" {{ if eqFold .Data.Housing.HousingType "landed" }}selected{{ end }}>Landed</option>
          <option value="other" {{ if eqFold .Data.Housing.HousingType "other" }}selected{{ end }}>Other</option>
        </select>
      </label>
      <label class="oz-field">
        <span>Location <span class="text-xs font-normal opacity-60">(optional)</span></span>
        <input class="input input-bordered" name="location" placeholder="e.g. Tengah / Punggol / Tampines" value="{{ .Data.Housing.Location }}">
      </label>
      <label class="oz-field">
        <span>Unit Type <span class="text-error" aria-label="required" title="Required">*</span></span>
        <select class="select select-bordered w-full" name="unit_type" required>
          <option value="" {{ if eq .Data.Housing.UnitType "" }}selected{{ end }}>Select unit type</option>
          <option value="2-room" {{ if eqFold .Data.Housing.UnitType "2-room" }}selected{{ end }}>2-Room</option>
          <option value="3-room" {{ if eqFold .Data.Housing.UnitType "3-room" }}selected{{ end }}>3-Room</option>
          <option value="4-room" {{ if eqFold .Data.Housing.UnitType "4-room" }}selected{{ end }}>4-Room</option>
          <option value="5-room" {{ if eqFold .Data.Housing.UnitType "5-room" }}selected{{ end }}>5-Room</option>
          <option value="executive" {{ if eqFold .Data.Housing.UnitType "executive" }}selected{{ end }}>Executive</option>
          <option value="landed" {{ if eqFold .Data.Housing.UnitType "landed" }}selected{{ end }}>Landed</option>
          <option value="other" {{ if eqFold .Data.Housing.UnitType "other" }}selected{{ end }}>Other</option>
        </select>
      </label>
      <div class="oz-field">
        <label class="oz-field-label" for="purchase_price"><span class="inline-flex items-center gap-1">Purchase Price (Dollars)<span class="text-error" aria-label="required" title="Required">*</span>{{ template "partials/help_tooltip" (dict "Key" "purchase_price" "Label" "Purchase Price") }}</span></label>
        <input class="input input-bordered" id="purchase_price" name="purchase_price" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="e.g. 500000.00" value="{{ if gt .Data.Housing.PurchasePriceCents 0 }}{{ moneyInput .Data.Housing.PurchasePriceCents }}{{ end }}" required>
      </div>
      <div class="oz-field" id="grant_amount_field">
        <label class="oz-field-label" for="grant_amount"><span class="inline-flex items-center gap-1">Grant Amount (Dollars)<span class="text-xs font-normal opacity-60">(calculated)</span>{{ template "partials/help_tooltip" (dict "Key" "grant_amount" "Label" "Grant Amount") }}</span></label>
        <input class="input input-bordered oz-readonly-input" id="grant_amount" name="grant_amount" type="number" min="0" step="0.01" inputmode="decimal" placeholder="Auto-calculated from household income" value="{{ if gt .Data.Housing.GrantAmountCents 0 }}{{ moneyInput .Data.Housing.GrantAmountCents }}{{ end }}" readonly>
      </div>
      <label class="oz-field" id="loan_type_field">
        <span>Loan Type <span class="text-error oz-required-standard" aria-label="required" title="Required">*</span></span>
        <select class="select select-bordered w-full" name="loan_type" id="loan_type" required>
          <option value="" {{ if eq .Data.Housing.LoanType "" }}selected{{ end }}>Select loan type</option>
          <option value="hdb" {{ if eqFold .Data.Housing.LoanType "hdb" }}selected{{ end }}>HDB Loan</option>
          <option value="bank" {{ if eqFold .Data.Housing.LoanType "bank" }}selected{{ end }}>Bank Loan</option>
          <option value="cash" {{ if eqFold .Data.Housing.LoanType "cash" }}selected{{ end }}>Cash (No Loan)</option>
        </select>
      </label>
      <div class="oz-field" id="loan_amount_field">
        <label class="oz-field-label" for="loan_amount"><span class="inline-flex items-center gap-1">Loan Amount (Dollars)<span class="text-error oz-required-loan" aria-label="required" title="Required">*</span>{{ template "partials/help_tooltip" (dict "Key" "loan_amount" "Label" "Loan Amount") }}</span></label>
        <input class="input input-bordered" id="loan_amount" name="loan_amount" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="e.g. 400000.00" value="{{ if gt .Data.Housing.LoanAmountCents 0 }}{{ moneyInput .Data.Housing.LoanAmountCents }}{{ end }}">
      </div>
      <div class="oz-field" id="interest_rate_field">
        <label class="oz-field-label" for="interest_rate_percent"><span class="inline-flex items-center gap-1">Interest Rate (%)<span class="text-error oz-required-interest" aria-label="required" title="Required">*</span><span class="text-xs font-normal opacity-60 oz-auto-interest hidden">(auto)</span>{{ template "partials/help_tooltip" (dict "Key" "interest_rate" "Label" "Interest Rate") }}</span></label>
        <input class="input input-bordered" id="interest_rate_percent" name="interest_rate_percent" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="e.g. 2.60" value="{{ if and (not (eqFold .Data.Housing.LoanType "hdb")) (gt .Data.Housing.InterestRateBps 0) }}{{ bpsInput .Data.Housing.InterestRateBps }}{{ end }}">
      </div>
      <div class="oz-field" id="loan_tenure_field">
        <label class="oz-field-label" for="loan_tenure_years"><span class="inline-flex items-center gap-1">Loan Tenure (Years)<span class="text-error oz-required-tenure" aria-label="required" title="Required">*</span><span class="text-xs font-normal opacity-60 oz-auto-tenure hidden">(auto)</span>{{ template "partials/help_tooltip" (dict "Key" "loan_tenure" "Label" "Loan Tenure") }}</span></label>
        <input class="input input-bordered{{ if and (eqFold .Data.Housing.HousingType "bto") (eqFold .Data.Housing.LoanType "hdb") }} oz-readonly-input{{ end }}" id="loan_tenure_years" name="loan_tenure_years" type="number" min="1" max="35" step="1" inputmode="numeric" placeholder="e.g. 30" value="{{ if and (gt .Data.Housing.LoanTenureMonths 0) (not (and (eqFold .Data.Housing.HousingType "bto") (eqFold .Data.Housing.LoanType "hdb"))) }}{{ monthsToYears .Data.Housing.LoanTenureMonths }}{{ end }}">
      </div>
      <div class="oz-field">
        <label class="oz-field-label" for="buyer_stamp_duty_display"><span class="inline-flex items-center gap-1">Estimated Buyer Stamp Duty (Dollars)<span class="text-xs font-normal opacity-60">(calculated)</span>{{ template "partials/help_tooltip" (dict "Key" "buyer_stamp_duty" "Label" "Estimated Buyer Stamp Duty") }}</span></label>
        <input class="input input-bordered oz-readonly-input" id="buyer_stamp_duty_display" type="text" value="{{ moneyInput .Data.Housing.BuyerStampDutyCents }}" readonly>
      </div>
      <div class="oz-field">
        <label class="oz-field-label" for="monthly_maintenance"><span class="inline-flex items-center gap-1">Monthly Maintenance (Dollars)<span class="text-xs font-normal opacity-60">(optional)</span>{{ template "partials/help_tooltip" (dict "Key" "monthly_maintenance" "Label" "Monthly Maintenance") }}</span></label>
        <input class="input input-bordered" id="monthly_maintenance" name="monthly_maintenance" type="number" min="0" step="0.01" inputmode="decimal" placeholder="e.g. 350.00" value="{{ if gt .Data.Housing.MonthlyMaintenanceCents 0 }}{{ moneyInput .Data.Housing.MonthlyMaintenanceCents }}{{ end }}">
      </div>
      <input type="hidden" name="renovation_budget" value="0">
      <input type="hidden" name="furniture_budget" value="0">
      <div class="oz-field">
        <label class="oz-field-label" for="legal_fees"><span class="inline-flex items-center gap-1">Legal Fees (Dollars)<span class="text-xs font-normal opacity-60">(optional)</span>{{ template "partials/help_tooltip" (dict "Key" "legal_fees" "Label" "Legal Fees") }}</span></label>
        <input class="input input-bordered" id="legal_fees" name="legal_fees" type="number" min="0" step="0.01" inputmode="decimal" placeholder="e.g. 3000.00" value="{{ if gt .Data.Housing.LegalFeesCents 0 }}{{ moneyInput .Data.Housing.LegalFeesCents }}{{ end }}">
      </div>
      <div class="oz-field">
        <label class="oz-field-label" for="expected_key_collection_date"><span class="inline-flex items-center gap-1">Expected Key Collection Date<span class="text-error" aria-label="required" title="Required">*</span>{{ template "partials/help_tooltip" (dict "Key" "expected_key_collection_date" "Label" "Expected Key Collection Date") }}</span></label>
        <input class="input input-bordered" id="expected_key_collection_date" name="expected_key_collection_date" type="date" value="{{ .Data.Housing.ExpectedKeyCollectionDate }}" required>
      </div>
      <div class="md:col-span-2 flex flex-wrap gap-2">
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn" href="/housing?family_id={{ .Data.FamilyID }}">Cancel</a>
      </div>
      <section class="md:col-span-2 card border border-base-300" id="dia_income_section">
        <div class="card-body p-4">
          <h3 class="font-semibold inline-flex items-center gap-1">DIA Income Inputs (Per Person){{ template "partials/help_tooltip" (dict "Key" "dia_income_section" "Label" "DIA Income Inputs") }}</h3>
          <p class="text-xs opacity-70">{{ housingTooltipSupportingTip "dia_income_section" }}</p>
          {{ if .Data.People }}
          <div class="overflow-x-auto oz-tooltip-overflow">
            <table class="table table-sm">
              <thead><tr><th>Name</th><th>Current Status</th><th><span class="inline-flex items-center gap-1">Estimated Monthly Income (Dollars){{ template "partials/help_tooltip" (dict "Key" "dia_income_estimated_income" "Label" "Estimated Monthly Income") }}</span></th></tr></thead>
              <tbody>
                {{ range .Data.People }}
                <tr>
                  <td>{{ .Name }}</td>
                  <td>{{ .EmploymentStatus }}</td>
                  <td>
                    <input class="input input-bordered input-sm w-full max-w-xs" type="number" min="0" step="0.01" inputmode="decimal" name="dia_income[{{ .Id }}]" value="{{ index $.Data.DIAIncomeDefaultInputs .Id }}" placeholder="e.g. 4200.00">
                  </td>
                </tr>
                {{ end }}
              </tbody>
            </table>
          </div>
          {{ else }}
          <div class="alert oz-alert-soft text-sm">No family profiles found yet. Add people in Profiles first.</div>
          {{ end }}
        </div>
      </section>
    </form>
  </div>
</section>
<script>
  (() => {
    const assessmentMode = document.getElementById("assessment_mode");
    const diaIncomeSection = document.getElementById("dia_income_section");
    const loanTypeField = document.getElementById("loan_type_field");
    const loanType = document.getElementById("loan_type");
    const housingType = document.getElementById("housing_type");
    const grantAmountField = document.getElementById("grant_amount_field");
    const loanAmountField = document.getElementById("loan_amount_field");
    const interestRateField = document.getElementById("interest_rate_field");
    const loanTenureField = document.getElementById("loan_tenure_field");
    const form = assessmentMode.closest("form");
    const purchasePriceInput = document.querySelector('input[name="purchase_price"]');
    const grantAmountInput = document.getElementById("grant_amount");
    const bsdDisplay = document.getElementById("buyer_stamp_duty_display");
    const loanAmount = document.getElementById("loan_amount");
    const interestRate = document.getElementById("interest_rate_percent");
    const loanTenure = document.getElementById("loan_tenure_years");
    const expectedKeyCollectionDate = document.getElementById("expected_key_collection_date");
    const loanAmountRequiredIndicators = document.querySelectorAll(".oz-required-loan");
    const interestRequiredIndicators = document.querySelectorAll(".oz-required-interest");
    const tenureRequiredIndicators = document.querySelectorAll(".oz-required-tenure");
    const autoInterestIndicators = document.querySelectorAll(".oz-auto-interest");
    const autoTenureIndicators = document.querySelectorAll(".oz-auto-tenure");
    if (!assessmentMode || !diaIncomeSection || !loanTypeField || !loanType || !housingType || !grantAmountField || !loanAmountField || !interestRateField || !loanTenureField || !form || !purchasePriceInput || !grantAmountInput || !bsdDisplay || !loanAmount || !interestRate || !loanTenure || !expectedKeyCollectionDate) return;

    const grantAmountEstimates = {
      "bto": {{ index .Data.GrantAmountEstimates "bto" }},
      "resale_hdb": {{ index .Data.GrantAmountEstimates "resale_hdb" }},
      "executive_condo": {{ index .Data.GrantAmountEstimates "executive_condo" }},
      "private_condo": {{ index .Data.GrantAmountEstimates "private_condo" }},
      "landed": {{ index .Data.GrantAmountEstimates "landed" }},
      "other": {{ index .Data.GrantAmountEstimates "other" }}
    };

    const parseMoney = (raw) => {
      const n = Number((raw || "").toString().replace(/[$,]/g, "").trim());
      if (Number.isNaN(n) || n < 0) return 0;
      return Math.round(n * 100);
    };

    const formatMoney = (cents) => (Math.max(0, cents) / 100).toFixed(2);

    const setVisible = (elements, visible) => {
      elements.forEach((element) => element.classList.toggle("hidden", !visible));
    };

    const maxLoanTenureYears = (housingType) => {
      const normalizedHousingType = (housingType || "").trim().toLowerCase();
      return normalizedHousingType === "bto" || normalizedHousingType === "resale_hdb" ? 30 : 35;
    };

    const calcBsd = (purchasePriceCents) => {
      let amount = Math.max(0, purchasePriceCents);
      const tiers = [
        [18000000, 100],
        [18000000, 200],
        [64000000, 300],
        [50000000, 400],
        [150000000, 500],
      ];
      let duty = 0;
      for (const [limit, bps] of tiers) {
        if (amount <= 0) break;
        const taxable = Math.min(amount, limit);
        duty += Math.floor((taxable * bps) / 10000);
        amount -= taxable;
      }
      if (amount > 0) {
        duty += Math.floor((amount * 600) / 10000);
      }
      return duty;
    };

    const refreshHousingRules = () => {
      const isCash = (loanType.value || "").trim().toLowerCase() === "cash";
      const isHdb = (loanType.value || "").trim().toLowerCase() === "hdb";
      const isDeferred = (assessmentMode.value || "").trim().toLowerCase() === "deferred";
      const selectedHousingType = (housingType.value || "").trim().toLowerCase();
      const isBtoHdb = selectedHousingType === "bto" && isHdb;
      const maxTenureYears = maxLoanTenureYears(selectedHousingType);
      const showLoanType = !isDeferred;
      const showLoanAmount = showLoanType && !isCash;
      const requiresInterestRate = showLoanType && !isCash && !isHdb;
      const requiresLoanTenure = showLoanType && !isCash && !isBtoHdb;
      const showGrant = !isDeferred;

      diaIncomeSection.style.display = isDeferred ? "" : "none";
      loanTypeField.style.display = showLoanType ? "" : "none";
      grantAmountField.style.display = showGrant ? "" : "none";
      loanAmountField.style.display = showLoanAmount ? "" : "none";
      interestRateField.style.display = showLoanType && !isCash ? "" : "none";
      loanTenureField.style.display = showLoanType && !isCash ? "" : "none";
      loanType.required = showLoanType;
      loanAmount.required = showLoanAmount;
      interestRate.required = requiresInterestRate;
      loanTenure.required = requiresLoanTenure;
      loanTenure.max = maxTenureYears.toString();
      setVisible(loanAmountRequiredIndicators, showLoanAmount);
      setVisible(interestRequiredIndicators, requiresInterestRate);
      setVisible(tenureRequiredIndicators, requiresLoanTenure);
      setVisible(autoInterestIndicators, showLoanType && !isCash && isHdb);
      setVisible(autoTenureIndicators, isBtoHdb);

      if (isHdb && !isCash) {
        interestRate.value = "";
        interestRate.placeholder = "Auto-set to 2.60 for HDB";
        interestRate.readOnly = true;
        interestRate.classList.add("oz-readonly-input");
      } else {
        interestRate.placeholder = "e.g. 2.60";
        interestRate.readOnly = false;
        interestRate.classList.remove("oz-readonly-input");
      }

      if (isBtoHdb) {
        loanTenure.value = "";
        loanTenure.placeholder = "Auto-set to 30 years for BTO + HDB";
        loanTenure.readOnly = true;
        loanTenure.classList.add("oz-readonly-input");
      } else {
        loanTenure.placeholder = `Max ${maxTenureYears} years`;
        loanTenure.readOnly = false;
        loanTenure.classList.remove("oz-readonly-input");
      }

      if (!showLoanAmount) {
        loanAmount.value = "";
      }
      if (!showLoanType) {
        loanType.value = "";
        interestRate.value = "";
        loanTenure.value = "";
      }
      if (!showGrant) {
        grantAmountInput.value = "";
      } else {
        const selectedHousingType = (housingType.value || "").trim().toLowerCase();
        if (selectedHousingType === "") {
          grantAmountInput.value = "";
        } else {
          grantAmountInput.value = formatMoney(grantAmountEstimates[selectedHousingType] || 0);
        }
      }
      if (isCash) {
        interestRate.value = "";
        loanTenure.value = "";
      }

      const purchasePriceCents = parseMoney(purchasePriceInput.value);
      const loanAmountCents = parseMoney(loanAmount.value);
      const interestRateValue = Number(interestRate.value || "0");
      const tenureValue = Number(loanTenure.value || "0");
      purchasePriceInput.setCustomValidity(purchasePriceInput.value && purchasePriceCents <= 0 ? "Purchase price must be more than 0." : "");
      loanAmount.setCustomValidity(showLoanAmount && loanAmount.value && loanAmountCents <= 0 ? "Loan amount must be more than 0." : "");
      interestRate.setCustomValidity(requiresInterestRate && interestRate.value && interestRateValue <= 0 ? "Interest rate must be more than 0." : "");
      if (!showLoanType || isCash || isBtoHdb || tenureValue <= maxTenureYears) {
        loanTenure.setCustomValidity("");
      } else {
        loanTenure.setCustomValidity(`Loan tenure cannot exceed ${maxTenureYears} years for the selected housing type.`);
      }
      bsdDisplay.value = formatMoney(calcBsd(purchasePriceCents));
    };

    loanType.addEventListener("change", refreshHousingRules);
    assessmentMode.addEventListener("change", refreshHousingRules);
    housingType.addEventListener("change", refreshHousingRules);
    loanAmount.addEventListener("input", refreshHousingRules);
    interestRate.addEventListener("input", refreshHousingRules);
    loanTenure.addEventListener("input", refreshHousingRules);
    purchasePriceInput.addEventListener("input", refreshHousingRules);
    form.addEventListener("submit", () => {
      const isCash = (loanType.value || "").trim().toLowerCase() === "cash";
      const isHdb = (loanType.value || "").trim().toLowerCase() === "hdb";
      const isDeferred = (assessmentMode.value || "").trim().toLowerCase() === "deferred";
      const selectedHousingType = (housingType.value || "").trim().toLowerCase();
      if (!isDeferred && !isCash && isHdb && selectedHousingType === "bto") {
        loanTenure.value = "30";
      }
    });
    refreshHousingRules();
  })();
</script>
{{ template "partials/footer" . }}
{{ end }}
