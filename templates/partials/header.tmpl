{{ define "partials/header" }}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }} | OurNeZt</title>
  <link rel="icon" type="image/png" href="/static/img/ournezt-logo.png">
  <link rel="apple-touch-icon" href="/static/img/ournezt-logo.png">
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <link href="/static/css/app.css" rel="stylesheet" type="text/css" />
</head>
<body class="min-h-screen">
  <div class="navbar oz-navbar px-4 md:px-6">
    <a class="oz-brand" href="/dashboard">
      <img src="/static/img/ournezt-logo.png" alt="OurNeZt logo">
      <span>OurNeZt</span>
    </a>
    <div class="ml-auto flex items-center gap-2">
      {{ if .User }}
        <div class="hidden md:flex items-center gap-2">
          {{ if .User.MustChangePassword }}
            <a class="btn btn-warning btn-sm" href="/change-password">Change Password</a>
          {{ else }}
            {{ if eq .User.Role "admin" }}
              <a class="btn btn-ghost btn-sm" href="/admin">Admin Dashboard</a>
              <a class="btn btn-ghost btn-sm" href="/admin/users">All Users</a>
            {{ else }}
              <a class="btn btn-ghost btn-sm" href="/dashboard">Dashboard</a>
              <a class="btn btn-ghost btn-sm" href="/families">Families</a>
              <a class="btn btn-ghost btn-sm" href="/people">Profiles</a>
              <a class="btn btn-ghost btn-sm" href="/housing">Housing</a>
              <a class="btn btn-ghost btn-sm btn-circle oz-profile-btn" href="/profile" aria-label="Profile" title="Profile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M4 20c1.9-3.4 5-5 8-5s6.1 1.6 8 5"></path>
                </svg>
                <span class="sr-only">Profile</span>
              </a>
            {{ end }}
          {{ end }}
          <form method="post" action="/logout" class="inline"><button class="btn btn-outline btn-sm">Logout</button></form>
        </div>

        <details class="oz-mobile-menu md:hidden">
          <summary class="btn btn-ghost btn-sm btn-circle" aria-label="Open menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </summary>
          <ul class="menu menu-sm oz-mobile-menu-panel">
            {{ if .User.MustChangePassword }}
              <li><a href="/change-password">Change Password</a></li>
            {{ else }}
              {{ if eq .User.Role "admin" }}
                <li><a href="/admin">Admin Dashboard</a></li>
                <li><a href="/admin/users">All Users</a></li>
              {{ else }}
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/families">Families</a></li>
                <li><a href="/people">Profiles</a></li>
                <li><a href="/housing">Housing</a></li>
                <li><a href="/profile">My Profile</a></li>
              {{ end }}
            {{ end }}
            <li>
              <form method="post" action="/logout">
                <button class="w-full text-left" type="submit">Logout</button>
              </form>
            </li>
          </ul>
        </details>
      {{ else }}
        <a class="btn btn-primary btn-sm" href="/login">Login</a>
      {{ end }}
    </div>
  </div>
  <main class="max-w-6xl mx-auto p-4 md:p-6 oz-main">
    {{ if .Error }}<div class="alert alert-error mb-4">{{ .Error }}</div>{{ end }}
    {{ if .Flash }}<div class="alert alert-success mb-4">{{ .Flash }}</div>{{ end }}
{{ end }}
