{{ define "partials/nav_icon" }}
<svg class="oz-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {{ if eq . "overview" }}<rect x="3.5" y="3.5" width="6.5" height="6.5" rx="1.5"/><rect x="14" y="3.5" width="6.5" height="6.5" rx="1.5"/><rect x="3.5" y="14" width="6.5" height="6.5" rx="1.5"/><rect x="14" y="14" width="6.5" height="6.5" rx="1.5"/>
  {{ else if eq . "households" }}<path d="M3 19v-2a4 4 0 0 1 4-4h3a4 4 0 0 1 4 4v2M16 13a4 4 0 0 1 5 4v2"/><circle cx="8.5" cy="6.5" r="3"/><path d="M16 3.5a3 3 0 0 1 0 6"/>
  {{ else if eq . "people" }}<circle cx="12" cy="7" r="3.5"/><path d="M5 20v-2a7 7 0 0 1 14 0v2"/>
  {{ else if eq . "homes" }}<path d="m3 10 9-7 9 7M5 9v11h14V9M9 20v-7h6v7"/>
  {{ else if eq . "guidance" }}<path d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Zm0 0v15"/>
  {{ else if eq . "password" }}<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/>
  {{ end }}
</svg>
{{ end }}
{{ define "partials/nav_links" }}
  {{ if .User.MustChangePassword }}
    <a href="/change-password" {{ if eq .CurrentPath "/change-password" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "password" }}<span>Change password</span></a>
    <a href="/faq" {{ if eq .CurrentPath "/faq" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "guidance" }}<span>Help &amp; guidance</span></a>
  {{ else if eq .User.Role "admin" }}
    <a href="/admin" {{ if eq .CurrentPath "/admin" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "overview" }}<span>Overview</span></a>
    <a href="/admin/users" {{ if eq .CurrentPath "/admin/users" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "households" }}<span>Manage users</span></a>
    <a href="/faq" {{ if eq .CurrentPath "/faq" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "guidance" }}<span>Help &amp; guidance</span></a>
  {{ else }}
    <a href="/dashboard" {{ if eq .CurrentPath "/dashboard" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "overview" }}<span>Overview</span></a>
    <a href="/families" {{ if navActive .CurrentPath "/families" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "households" }}<span>Households</span></a>
    <a href="/people" {{ if navActive .CurrentPath "/people" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "people" }}<span>People</span></a>
    <a href="/housing" {{ if navActive .CurrentPath "/housing" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "homes" }}<span>Homes</span></a>
    <a href="/faq" {{ if eq .CurrentPath "/faq" }}aria-current="page"{{ end }}>{{ template "partials/nav_icon" "guidance" }}<span>Guidance</span></a>
  {{ end }}
{{ end }}
{{ define "partials/header" }}
{{ $csrf := .CSRFField }}
<!doctype html>
<html lang="en" data-theme="ournezt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ .Title }} | OurNeZt</title>
  <link rel="icon" type="image/png" href="/static/img/ournezt-logo.png">
  <link rel="apple-touch-icon" href="/static/img/ournezt-logo.png">
  <link href="/static/vendor/ui.css" rel="stylesheet" type="text/css" />
  <link href="/static/css/app.css?v=20260924-criterion-actions" rel="stylesheet" type="text/css" />
  <link href="/static/css/wabi-sabi.css?v=20261115-finance-colours" rel="stylesheet" type="text/css" />
</head>
<body class="min-h-screen">
  <a class="oz-skip-link" href="#main-content">Skip to content</a>
  <header class="oz-navbar">
    <div class="oz-navbar-inner">
      <a class="oz-brand" href="{{ if .User }}/dashboard{{ else }}/{{ end }}" aria-label="OurNeZt home">
        <img src="/static/img/ournezt-logo.png" alt="" width="40" height="40">
        <span>OurNeZt<span class="oz-brand-caption">A little room to plan.</span></span>
      </a>
      {{ if .User }}
      <nav class="oz-desktop-nav" aria-label="Main navigation">{{ template "partials/nav_links" . }}</nav>
      <div class="oz-account-actions">
        {{ if and (ne .User.Role "admin") (not .User.MustChangePassword) }}
        <a class="oz-account-link" href="/profile" aria-label="My account" title="My account" {{ if navActive .CurrentPath "/profile" }}aria-current="page"{{ end }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20v-1a7 7 0 0 1 14 0v1"/></svg>
          <span>My account</span>
        </a>
        {{ end }}
        <form method="post" action="/logout" class="oz-desktop-logout">{{ $csrf }}<button class="btn btn-ghost btn-sm" type="submit"><svg class="oz-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4H5v16h4M9 12h12m-4-4 4 4-4 4"/></svg><span>Sign out</span></button></form>
        <details class="oz-mobile-menu">
          <summary class="btn btn-ghost btn-sm" aria-label="Navigation menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 8h16M4 16h16"/></svg>
            <span>Menu</span>
          </summary>
          <nav class="oz-mobile-menu-panel" aria-label="Mobile navigation">
            {{ template "partials/nav_links" . }}
            {{ if and (ne .User.Role "admin") (not .User.MustChangePassword) }}<a href="/profile">My account</a>{{ end }}
            <form method="post" action="/logout">{{ $csrf }}<button type="submit">Sign out</button></form>
          </nav>
        </details>
      </div>
      {{ else }}
      <span class="oz-navbar-note">Home. Finances. Life, together.</span>
      <a class="btn btn-outline btn-sm" href="/login">Sign in <span aria-hidden="true">&rarr;</span></a>
      {{ end }}
    </div>
  </header>
  {{ with .MaintenanceNotice }}
  <section class="oz-maintenance-banner oz-maintenance-{{ .Level }}" role="status" aria-live="polite">
    <div class="max-w-6xl mx-auto px-4 md:px-6 py-4 oz-maintenance-inner">
      <div class="oz-maintenance-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3 2.8 19a1.4 1.4 0 0 0 1.2 2h16a1.4 1.4 0 0 0 1.2-2L12 3Z"></path>
          <path d="M12 8v5"></path>
          <path d="M12 17h.01"></path>
        </svg>
      </div>
      <div class="oz-maintenance-copy">
        <div class="oz-maintenance-heading">
          <span class="oz-maintenance-badge">Maintenance Notice</span>
          {{ if .Title }}<p class="oz-maintenance-title">{{ .Title }}</p>{{ end }}
        </div>
        <p class="oz-maintenance-message">{{ .Message }}</p>
        {{ if or .StartsAt .EndsAt }}
        <div class="oz-maintenance-window" aria-label="Maintenance window">
          {{ if .StartsAt }}<span>Starts: {{ .StartsAt }}</span>{{ end }}
          {{ if .EndsAt }}<span>Expected end: {{ .EndsAt }}</span>{{ end }}
        </div>
        {{ end }}
      </div>
    </div>
  </section>
  {{ end }}
  <main id="main-content" class="max-w-6xl mx-auto p-4 md:p-6 oz-main" tabindex="-1">
    {{ if .Error }}<div class="alert alert-error mb-4">{{ .Error }}</div>{{ end }}
    {{ if .Flash }}<div class="alert alert-success mb-4">{{ .Flash }}</div>{{ end }}
{{ end }}
