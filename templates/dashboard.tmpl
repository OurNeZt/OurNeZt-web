{{ define "dashboard" }}
{{ template "partials/header" . }}
<section class="oz-page-heading" aria-labelledby="dashboard-title">
  <div class="oz-page-title-group">
    <span class="oz-page-icon">{{ template "partials/nav_icon" "overview" }}</span>
    <h1 id="dashboard-title">Overview</h1>
  </div>
    {{ if .Data.Families }}
    <form method="get" action="/dashboard" class="oz-household-switch">
      <label for="dashboard-household">Planning for</label>
      <select id="dashboard-household" class="select select-bordered" name="family_id">
        {{ range .Data.Families }}<option value="{{ .Id }}" {{ if eq $.Data.FamilyID .Id }}selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>
      <button class="btn btn-sm" type="submit">View</button>
    </form>
    {{ end }}
</section>
{{ if .Data.Dashboard }}
<div class="oz-section-intro"><h2>Monthly snapshot</h2><p>SGD / month</p></div>
<div class="oz-metrics">
  <div class="oz-metric oz-metric-income"><div class="oz-metric-header"><p class="oz-metric-label">Take-home income</p><span class="oz-metric-icon">{{ template "partials/finance_icon" "income" }}</span></div><p class="oz-metric-value">{{ cents .Data.Income.TakeHomeIncomeCents }}</p><p class="oz-metric-note">After deductions</p></div>
  <div class="oz-metric oz-metric-expenses"><div class="oz-metric-header"><p class="oz-metric-label">Living expenses</p><span class="oz-metric-icon">{{ template "partials/finance_icon" "expenses" }}</span></div><p class="oz-metric-value">{{ cents .Data.Income.MonthlyExpensesCents }}</p><p class="oz-metric-note">Your listed expenses</p></div>
  <div class="oz-metric oz-metric-featured {{ if lt .Data.Income.MonthlySurplusCents 0 }}oz-metric-negative{{ end }}"><div class="oz-metric-header"><p class="oz-metric-label">{{ if lt .Data.Income.MonthlySurplusCents 0 }}Monthly shortfall{{ else }}Money left{{ end }}</p><span class="oz-metric-icon">{{ template "partials/finance_icon" "surplus" }}</span></div><p class="oz-metric-value">{{ cents .Data.Income.MonthlySurplusCents }}</p><p class="oz-metric-note">After listed expenses</p></div>
  <div class="oz-metric oz-metric-gross"><div class="oz-metric-header"><p class="oz-metric-label">Gross income</p><span class="oz-metric-icon">{{ template "partials/finance_icon" "gross" }}</span></div><p class="oz-metric-value">{{ cents .Data.Income.CurrentGrossIncomeCents }}</p><p class="oz-metric-note">Before deductions</p></div>
</div>
<div class="grid gap-4 md:grid-cols-2 oz-dashboard-grid">
  <section class="card bg-base-100 shadow">
    <div class="card-body">
      <div class="oz-chart-heading"><span class="oz-chart-icon oz-chart-icon-income">{{ template "partials/finance_icon" "trend" }}</span><div><h2 class="card-title text-base">Income over time</h2><p class="oz-chart-caption">Gross income &middot; SGD / month</p></div></div>
      <div class="oz-chart-box"><canvas id="incomeChart" aria-label="Income overview chart"></canvas></div>
    </div>
  </section>
  <section class="card bg-base-100 shadow">
    <div class="card-body">
      <div class="oz-chart-heading"><span class="oz-chart-icon oz-chart-icon-housing">{{ template "partials/finance_icon" "housing" }}</span><div><h2 class="card-title text-base">Home comparison</h2><p class="oz-chart-caption">Housing cost and money left &middot; SGD / month</p></div></div>
      {{ if gt .Data.HiddenHousingCount 0 }}
      <div class="alert oz-alert-soft text-xs">{{ .Data.HiddenHousingCount }} hidden housing option{{ if ne .Data.HiddenHousingCount 1 }}s are{{ else }} is{{ end }} excluded from dashboard charts and timeline.</div>
      {{ end }}
      {{ if .Data.UsesProjected }}
      <div class="alert oz-alert-soft text-xs">Projected take-home is used for this housing view because future income profiles are present.</div>
      {{ end }}
      {{ if .Data.HousingCharts }}
      <div class="oz-chart-box"><canvas id="housingImpactChart" aria-label="Housing impact chart"></canvas></div>
      {{ else }}
      <div class="alert oz-alert-soft text-sm">Add at least one housing option to see comparison impact here.</div>
      {{ end }}
    </div>
  </section>
</div>
{{ if .Data.Housing }}
<section class="card bg-base-100 shadow mt-4"><div class="card-body"><h2 class="card-title text-base">Your home shortlist</h2>
  <div class="grid gap-3 md:grid-cols-2">{{ range .Data.Housing }}<article class="border border-base-300 rounded-box p-4">
    <h3 class="font-semibold"><a class="link" href="/housing/{{ .Id }}?family_id={{ $.Data.FamilyID }}#evaluation">{{ .Name }}</a></h3>
    {{ template "partials/evaluation_summary" .Evaluation }}
  </article>{{ end }}</div>
  <a class="link text-sm" href="/housing/compare?family_id={{ .Data.FamilyID }}">Compare visible homes</a>
</div></section>
{{ end }}
<section class="card bg-base-100 shadow mt-4">
  <div class="card-body">
    <div class="oz-chart-heading"><span class="oz-chart-icon oz-chart-icon-payments">{{ template "partials/finance_icon" "payments" }}</span><div><h2 class="card-title text-base">Payment timeline</h2><p class="oz-chart-caption">Monthly amounts on the left axis; one-off payments on the right.</p></div></div>
    {{ if .Data.TimelineSeries }}
    <label class="oz-field max-w-sm">
      <span>Housing Option</span>
      <select id="timelineHousingSelect" class="select select-bordered w-full">
        {{ range $i, $series := .Data.TimelineSeries }}
        <option value="{{ $i }}">{{ $series.HousingName }}</option>
        {{ end }}
      </select>
    </label>
    <div class="oz-chart-box oz-chart-box-timeline"><canvas id="timelineChart" aria-label="Payment and income timeline chart"></canvas></div>
    <div class="oz-chart-legend-mobile" aria-hidden="true">
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-line"></span>Take-Home</span>
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-expenses"></span>Monthly payment</span>
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-upfront"></span>Initial payment</span>
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-future"></span>Final downpayment</span>
    </div>
    {{ else }}
    <div class="alert oz-alert-soft text-sm">Add at least one housing option to show payment timeline.</div>
    {{ end }}
  </div>
</section>
<div class="mt-6 flex gap-2 flex-wrap">
  <a class="btn btn-sm" href="/people?family_id={{ .Data.FamilyID }}">Manage Profiles</a>
  <a class="btn btn-sm" href="/housing?family_id={{ .Data.FamilyID }}">Manage Housing</a>
  <a class="btn btn-sm" href="/housing/compare?family_id={{ .Data.FamilyID }}">Compare Housing</a>
</div>
<script nonce="{{ $.CSPNonce }}" src="/static/vendor/chart.umd.js"></script>
<script nonce="{{ $.CSPNonce }}">
  (() => {
    if (!window.Chart) return;
    Chart.defaults.color = "#646f59";
    Chart.defaults.borderColor = "#e1e3d5";
    Chart.defaults.font.family = '"Segoe UI", system-ui, sans-serif';
    Chart.defaults.font.size = 13;
    const theme = getComputedStyle(document.documentElement);
    const chartColors = {
      income: theme.getPropertyValue("--oz-chart-income").trim() || "#4677ac",
      expenses: theme.getPropertyValue("--oz-chart-expenses").trim() || "#c16b50",
      surplus: theme.getPropertyValue("--oz-chart-surplus").trim() || "#34866f",
      upfront: theme.getPropertyValue("--oz-chart-upfront").trim() || "#b7862d",
      future: theme.getPropertyValue("--oz-chart-future").trim() || "#8967ad"
    };
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      Chart.defaults.animation = false;
    }

    const incomeCtx = document.getElementById("incomeChart");
    if (incomeCtx) {
      new Chart(incomeCtx, {
        type: "line",
        data: {
          labels: [
            {{- range $i, $label := .Data.IncomeTrendLabels -}}
              {{- if $i }},{{ end -}}
              {{ printf "%q" $label }}
            {{- end -}}
          ],
          datasets: [{
            label: "Recorded Gross Income (SGD)",
            data: [
              {{- range $i, $gross := .Data.IncomeTrendGrossCents -}}
                {{- if $i }},{{ end -}}
                {{ $gross }} / 100
              {{- end -}}
            ],
            borderColor: chartColors.income,
            backgroundColor: "rgba(70,119,172,0.13)",
            tension: 0.28,
            fill: true,
            pointRadius: 3,
            pointHoverRadius: 5,
            borderWidth: 3
          },
          {
            label: "Projected Gross (DIA)",
            data: [
              {{- range $i, $gross := .Data.IncomeTrendProjectedGrossCents -}}
                {{- if $i }},{{ end -}}
                {{ if lt $gross 0 }}null{{ else }}{{ $gross }} / 100{{ end }}
              {{- end -}}
            ],
            borderColor: chartColors.future,
            backgroundColor: "rgba(137,103,173,0.12)",
            borderDash: [6, 4],
            showLine: true,
            spanGaps: true,
            tension: 0.18,
            pointRadius: 5,
            pointHoverRadius: 7
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } },
          scales: {
            x: {
              title: {
                display: true,
                text: "Month"
              }
            },
            y: {
              ticks: {
                callback: (v) => "$" + Number(v).toLocaleString()
              }
            }
          }
        }
      });
    }

    const housingCtx = document.getElementById("housingImpactChart");
    if (housingCtx) {
      new Chart(housingCtx, {
        type: "bar",
        data: {
          labels: [
            {{- range $i, $r := .Data.HousingCharts -}}
              {{- if $i }},{{ end -}}
              {{ printf "%q" $r.Name }}
            {{- end -}}
          ],
          datasets: [
            {
              label: "Housing cost",
              data: [
                {{- range $i, $r := .Data.HousingCharts -}}
                  {{- if $i }},{{ end -}}
                  {{ $r.MonthlyHousingCostCents }} / 100
                {{- end -}}
              ],
              backgroundColor: chartColors.expenses,
              borderColor: chartColors.expenses,
              borderWidth: 0,
              borderRadius: 5,
              maxBarThickness: 18
            },
            {
              label: "Money left after housing",
              data: [
                {{- range $i, $r := .Data.HousingCharts -}}
                  {{- if $i }},{{ end -}}
                  {{ $r.MonthlySurplusAfterCents }} / 100
                {{- end -}}
              ],
              backgroundColor: (context) => context.raw < 0 ? chartColors.expenses : chartColors.surplus,
              borderColor: chartColors.surplus,
              borderWidth: 0,
              borderRadius: 5,
              maxBarThickness: 18
            }
          ]
        },
        options: {
          indexAxis: "y",
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: "bottom" }
          },
          scales: {
            x: {
              beginAtZero: true,
              ticks: {
                callback: (v) => "$" + Number(v).toLocaleString()
              }
            },
            y: {
              grid: { display: false },
              ticks: { autoSkip: false }
            }
          }
        }
      });
    }

      const timelineCtx = document.getElementById("timelineChart");
      if (timelineCtx) {
      const isCompactTimeline = () => window.matchMedia("(max-width: 640px)").matches;
      const timelineHousingSelect = document.getElementById("timelineHousingSelect");
      const currentTakeHome = {{ .Data.Income.TakeHomeIncomeCents }} / 100;
      const timelineSeries = [
        {{- range $i, $s := .Data.TimelineSeries -}}
          {{- if $i }},{{ end -}}
          {
            id: {{ printf "%q" $s.HousingID }},
            name: {{ printf "%q" $s.HousingName }},
            labels: [
              "Today ({{ $s.YearNow }})",
              "Initial Payment ({{ $s.YearInitialDownpayment }})",
              "Final DP ({{ $s.YearFinalDownpayment }})",
              "Monthly Payment ({{ $s.YearFinalDownpayment }})"
            ],
            compactLabels: [
              ["Today", "{{ $s.YearNow }}"],
              ["Init Pay", "{{ $s.YearInitialDownpayment }}"],
              ["Final DP", "{{ $s.YearFinalDownpayment }}"],
              ["Monthly", "{{ $s.YearFinalDownpayment }}"]
            ],
            estimatedTakeHome: [
              currentTakeHome,
              {{ $s.EstimatedTakeHomeCents }} / 100,
              {{ $s.EstimatedTakeHomeCents }} / 100,
              {{ $s.EstimatedTakeHomeCents }} / 100
            ],
            monthlyPaymentNeed: [
              null,
              null,
              null,
              {{ $s.MonthlyPaymentNeedCents }} / 100
            ],
            initialDownpayment: [
              null,
              {{ $s.InitialPaymentCents }} / 100,
              null,
              null
            ],
            finalDownpayment: [
              null,
              null,
              {{ $s.FinalDownpaymentCents }} / 100,
              null
            ]
          }
        {{- end -}}
      ];
      if (!timelineSeries.length) return;

      const toMoneyTick = (v) => "$" + Number(v).toLocaleString();
      const resolveSelectedSeries = () => {
        if (!timelineHousingSelect) return timelineSeries[0];
        const selectedIndex = Number.parseInt((timelineHousingSelect.value || "0").trim(), 10);
        if (Number.isNaN(selectedIndex) || selectedIndex < 0 || selectedIndex >= timelineSeries.length) {
          return timelineSeries[0];
        }
        return timelineSeries[selectedIndex];
      };

      const initialSeries = resolveSelectedSeries();
      const initialCompactTimeline = isCompactTimeline();
      const timelineChart = new Chart(timelineCtx, {
        type: "bar",
        data: {
          labels: initialCompactTimeline ? initialSeries.compactLabels : initialSeries.labels,
          datasets: [
            {
              label: "Take-Home",
              data: initialSeries.estimatedTakeHome,
              borderColor: chartColors.income,
              backgroundColor: chartColors.income,
              yAxisID: "monthlyAxis",
              type: "line",
              tension: 0.22,
              spanGaps: true,
              pointRadius: 3,
              pointHoverRadius: 4,
              pointBackgroundColor: "#fffdf8",
              pointBorderColor: chartColors.income,
              pointBorderWidth: 2,
              borderWidth: 2
            },
            {
              label: "Monthly payment",
              data: initialSeries.monthlyPaymentNeed,
              backgroundColor: chartColors.expenses,
              borderColor: chartColors.expenses,
              yAxisID: "monthlyAxis",
              type: "bar",
              borderWidth: 1,
              grouped: false,
              categoryPercentage: 0.54,
              barPercentage: 0.5,
              borderRadius: 0
            },
            {
              label: "Initial Payment",
              data: initialSeries.initialDownpayment,
              backgroundColor: chartColors.upfront,
              borderColor: chartColors.upfront,
              borderWidth: 1,
              yAxisID: "upfrontAxis",
              stack: "downpayment",
              grouped: false,
              categoryPercentage: 0.54,
              barPercentage: 0.82,
              borderRadius: 0
            },
            {
              label: "Final downpayment",
              data: initialSeries.finalDownpayment,
              backgroundColor: chartColors.future,
              borderColor: chartColors.future,
              borderWidth: 1,
              yAxisID: "upfrontAxis",
              stack: "downpayment",
              grouped: false,
              categoryPercentage: 0.54,
              barPercentage: 0.82,
              borderRadius: 0
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: "index",
            intersect: false
          },
          plugins: {
            legend: {
              display: !initialCompactTimeline,
              position: "bottom",
              labels: {
                usePointStyle: false,
                boxWidth: initialCompactTimeline ? 18 : 42,
                padding: initialCompactTimeline ? 12 : 16,
                font: {
                  size: initialCompactTimeline ? 12 : 13
                }
              }
            }
          },
          scales: {
            x: {
              offset: true,
              ticks: {
                autoSkip: false,
                maxRotation: initialCompactTimeline ? 20 : 0,
                minRotation: initialCompactTimeline ? 20 : 0,
                font: {
                  size: initialCompactTimeline ? 12 : 13
                }
              },
              title: {
                display: !initialCompactTimeline,
                text: "Housing payment stage"
              }
            },
            monthlyAxis: {
              type: "linear",
              position: "left",
              ticks: {
                callback: toMoneyTick,
                font: {
                  size: initialCompactTimeline ? 12 : 13
                }
              },
              title: {
                display: !initialCompactTimeline,
                text: "Monthly income and payment"
              }
            },
            upfrontAxis: {
              type: "linear",
              position: "right",
              grid: {
                drawOnChartArea: false
              },
              ticks: {
                callback: toMoneyTick,
                font: {
                  size: initialCompactTimeline ? 12 : 13
                }
              },
              title: {
                display: !initialCompactTimeline,
                text: "One-time payments"
              }
            }
          }
        }
      });

      let lastCompactTimeline = initialCompactTimeline;
      const applyTimelinePresentation = () => {
        const compact = isCompactTimeline();
        const selected = resolveSelectedSeries();
        timelineChart.data.labels = compact ? selected.compactLabels : selected.labels;
        timelineChart.options.plugins.legend.display = !compact;
        timelineChart.options.plugins.legend.labels.boxWidth = compact ? 18 : 42;
        timelineChart.options.plugins.legend.labels.padding = compact ? 12 : 16;
        timelineChart.options.plugins.legend.labels.font.size = compact ? 12 : 13;
        timelineChart.options.scales.x.ticks.maxRotation = compact ? 20 : 0;
        timelineChart.options.scales.x.ticks.minRotation = compact ? 20 : 0;
        timelineChart.options.scales.x.ticks.font.size = compact ? 12 : 13;
        timelineChart.options.scales.x.title.display = !compact;
        timelineChart.options.scales.monthlyAxis.ticks.font.size = compact ? 12 : 13;
        timelineChart.options.scales.monthlyAxis.title.display = !compact;
        timelineChart.options.scales.monthlyAxis.title.text = "Monthly income and payment";
        timelineChart.options.scales.upfrontAxis.ticks.font.size = compact ? 12 : 13;
        timelineChart.options.scales.upfrontAxis.title.display = !compact;
        timelineChart.options.scales.upfrontAxis.title.text = "One-time payments";
        timelineChart.update();
        lastCompactTimeline = compact;
      };

      if (timelineHousingSelect) {
        timelineHousingSelect.addEventListener("change", () => {
          const selected = resolveSelectedSeries();
          timelineChart.data.labels = isCompactTimeline() ? selected.compactLabels : selected.labels;
          timelineChart.data.datasets[0].data = selected.estimatedTakeHome;
          timelineChart.data.datasets[1].data = selected.monthlyPaymentNeed;
          timelineChart.data.datasets[2].data = selected.initialDownpayment;
          timelineChart.data.datasets[3].data = selected.finalDownpayment;
          timelineChart.update();
        });
      }
      window.addEventListener("resize", () => {
        const compact = isCompactTimeline();
        if (compact === lastCompactTimeline) return;
        applyTimelinePresentation();
      });
    }
  })();
</script>
{{ else }}
<section class="card oz-empty-state">
  <div class="oz-empty-symbol" aria-hidden="true">&#8962;</div>
  <h2>Your next chapter starts here.</h2>
  <p>Create a household for yourself or the people you plan with. Then add your financial profiles and the homes you're considering.</p>
  <a class="btn btn-primary" href="/families">Set up your household <span aria-hidden="true">&rarr;</span></a>
</section>
{{ end }}
{{ template "partials/footer" . }}
{{ end }}
