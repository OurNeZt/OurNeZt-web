{{ define "dashboard" }}
{{ template "partials/header" . }}
<section class="card bg-base-100 shadow">
  <div class="card-body">
    <h1 class="card-title">Household Dashboard</h1>
    {{ if .Data.Families }}
    <form method="get" action="/dashboard" class="flex gap-2">
      <select class="select select-bordered" name="family_id">
        {{ range .Data.Families }}<option value="{{ .Id }}" {{ if eq $.Data.FamilyID .Id }}selected{{ end }}>{{ .Name }}</option>{{ end }}
      </select>
      <button class="btn" type="submit">Switch</button>
    </form>
    {{ else }}
    <p>No family yet. <a class="link" href="/families">Create or join one</a>.</p>
    {{ end }}
  </div>
</section>
{{ if .Data.Dashboard }}
<div class="grid md:grid-cols-4 gap-4 mt-6">
  <div class="stat bg-base-100 rounded-box shadow"><div class="stat-title">Gross Income</div><div class="stat-value text-lg">{{ cents .Data.Income.CurrentGrossIncomeCents }}</div></div>
  <div class="stat bg-base-100 rounded-box shadow"><div class="stat-title">Take Home</div><div class="stat-value text-lg">{{ cents .Data.Income.TakeHomeIncomeCents }}</div></div>
  <div class="stat bg-base-100 rounded-box shadow"><div class="stat-title">Monthly Expenses</div><div class="stat-value text-lg">{{ cents .Data.Income.MonthlyExpensesCents }}</div></div>
  <div class="stat bg-base-100 rounded-box shadow"><div class="stat-title">Monthly Surplus</div><div class="stat-value text-lg">{{ cents .Data.Income.MonthlySurplusCents }}</div></div>
</div>
<div class="grid gap-4 mt-6 md:grid-cols-2">
  <section class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title text-base">Income Overview</h2>
      <p class="text-xs opacity-70">Monthly time series of gross income with DIA projected gross shown as a future point.</p>
      <div class="oz-chart-box"><canvas id="incomeChart" aria-label="Income overview chart"></canvas></div>
    </div>
  </section>
  <section class="card bg-base-100 shadow">
    <div class="card-body">
      <h2 class="card-title text-base">Housing Scenario Impact</h2>
      <p class="text-xs opacity-70">Monthly housing cost and surplus after housing by visible option.</p>
      {{ if gt .Data.HiddenHousingCount 0 }}
      <div class="alert oz-alert-soft text-xs">{{ .Data.HiddenHousingCount }} hidden housing option{{ if ne .Data.HiddenHousingCount 1 }}s are{{ else }} is{{ end }} excluded from dashboard charts and timeline.</div>
      {{ end }}
      {{ if .Data.UsesProjected }}
      <div class="alert oz-alert-soft text-xs">Projected take-home is used for this housing view because future income profiles are present.</div>
      {{ end }}
      {{ if .Data.HousingCharts }}
      <div class="oz-chart-box"><canvas id="housingImpactChart" aria-label="Housing impact chart"></canvas></div>
      {{ else }}
      <div class="alert oz-alert-soft text-sm">Add at least one housing option to see comparison impact here.</div>
      {{ end }}
    </div>
  </section>
</div>
<section class="card bg-base-100 shadow mt-4">
  <div class="card-body">
    <h2 class="card-title text-base">Payment vs Income Timeline</h2>
    <p class="text-xs opacity-70">Follow each visible housing option from today through total initial payment, final downpayment, and the later monthly payment stage.</p>
    {{ if .Data.TimelineSeries }}
    <label class="oz-field max-w-sm">
      <span>Housing Option</span>
      <select id="timelineHousingSelect" class="select select-bordered w-full">
        {{ range $i, $series := .Data.TimelineSeries }}
        <option value="{{ $i }}">{{ $series.HousingName }}</option>
        {{ end }}
      </select>
    </label>
    <div class="oz-chart-box oz-chart-box-timeline"><canvas id="timelineChart" aria-label="Payment and income timeline chart"></canvas></div>
    <div class="oz-chart-legend-mobile" aria-hidden="true">
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-line"></span>Take-Home</span>
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-brown"></span>Monthly Need</span>
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-blue"></span>Initial Payment</span>
      <span class="oz-chart-legend-item"><span class="oz-chart-legend-swatch oz-chart-legend-swatch-coral"></span>Final DP</span>
    </div>
    {{ else }}
    <div class="alert oz-alert-soft text-sm">Add at least one housing option to show payment timeline.</div>
    {{ end }}
  </div>
</section>
<div class="mt-6 flex gap-2 flex-wrap">
  <a class="btn btn-sm" href="/people?family_id={{ .Data.FamilyID }}">Manage Profiles</a>
  <a class="btn btn-sm" href="/housing?family_id={{ .Data.FamilyID }}">Manage Housing</a>
  <a class="btn btn-sm" href="/housing/compare?family_id={{ .Data.FamilyID }}">Compare Housing</a>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script>
  (() => {
    if (!window.Chart) return;

    const incomeCtx = document.getElementById("incomeChart");
    if (incomeCtx) {
      new Chart(incomeCtx, {
        type: "line",
        data: {
          labels: [
            {{- range $i, $label := .Data.IncomeTrendLabels -}}
              {{- if $i }},{{ end -}}
              {{ printf "%q" $label }}
            {{- end -}}
          ],
          datasets: [{
            label: "Recorded Gross Income (SGD)",
            data: [
              {{- range $i, $gross := .Data.IncomeTrendGrossCents -}}
                {{- if $i }},{{ end -}}
                {{ $gross }} / 100
              {{- end -}}
            ],
            borderColor: "#ef7f7a",
            backgroundColor: "rgba(239,127,122,0.18)",
            tension: 0.28,
            fill: true,
            pointRadius: 3,
            pointHoverRadius: 5,
            borderWidth: 2
          },
          {
            label: "Projected Gross (DIA)",
            data: [
              {{- range $i, $gross := .Data.IncomeTrendProjectedGrossCents -}}
                {{- if $i }},{{ end -}}
                {{ if lt $gross 0 }}null{{ else }}{{ $gross }} / 100{{ end }}
              {{- end -}}
            ],
            borderColor: "#385a82",
            backgroundColor: "rgba(56,90,130,0.12)",
            borderDash: [6, 4],
            showLine: true,
            spanGaps: true,
            tension: 0.18,
            pointRadius: 5,
            pointHoverRadius: 7
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom" } },
          scales: {
            x: {
              title: {
                display: true,
                text: "Month"
              }
            },
            y: {
              ticks: {
                callback: (v) => "$" + Number(v).toLocaleString()
              }
            }
          }
        }
      });
    }

    const housingCtx = document.getElementById("housingImpactChart");
    if (housingCtx) {
      new Chart(housingCtx, {
        type: "bar",
        data: {
          labels: [
            {{- range $i, $r := .Data.HousingCharts -}}
              {{- if $i }},{{ end -}}
              {{ printf "%q" $r.Name }}
            {{- end -}}
          ],
          datasets: [
            {
              label: "Monthly Housing Cost",
              data: [
                {{- range $i, $r := .Data.HousingCharts -}}
                  {{- if $i }},{{ end -}}
                  {{ $r.MonthlyHousingCostCents }} / 100
                {{- end -}}
              ],
              backgroundColor: "rgba(56,90,130,0.72)",
              borderColor: "#385a82",
              borderWidth: 1
            },
            {
              label: "Surplus After Housing",
              data: [
                {{- range $i, $r := .Data.HousingCharts -}}
                  {{- if $i }},{{ end -}}
                  {{ $r.MonthlySurplusAfterCents }} / 100
                {{- end -}}
              ],
              backgroundColor: "rgba(126,161,61,0.72)",
              borderColor: "#7ea13d",
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: "bottom" }
          },
          scales: {
            y: {
              ticks: {
                callback: (v) => "$" + Number(v).toLocaleString()
              }
            }
          }
        }
      });
    }

      const timelineCtx = document.getElementById("timelineChart");
      if (timelineCtx) {
      const isCompactTimeline = () => window.matchMedia("(max-width: 640px)").matches;
      const timelineHousingSelect = document.getElementById("timelineHousingSelect");
      const currentTakeHome = {{ .Data.Income.TakeHomeIncomeCents }} / 100;
      const timelineSeries = [
        {{- range $i, $s := .Data.TimelineSeries -}}
          {{- if $i }},{{ end -}}
          {
            id: {{ printf "%q" $s.HousingID }},
            name: {{ printf "%q" $s.HousingName }},
            labels: [
              "Today ({{ $s.YearNow }})",
              "Initial Payment ({{ $s.YearInitialDownpayment }})",
              "Final DP ({{ $s.YearFinalDownpayment }})",
              "Monthly Payment ({{ $s.YearFinalDownpayment }})"
            ],
            compactLabels: [
              ["Today", "{{ $s.YearNow }}"],
              ["Init Pay", "{{ $s.YearInitialDownpayment }}"],
              ["Final DP", "{{ $s.YearFinalDownpayment }}"],
              ["Monthly", "{{ $s.YearFinalDownpayment }}"]
            ],
            estimatedTakeHome: [
              currentTakeHome,
              {{ $s.EstimatedTakeHomeCents }} / 100,
              {{ $s.EstimatedTakeHomeCents }} / 100,
              {{ $s.EstimatedTakeHomeCents }} / 100
            ],
            monthlyPaymentNeed: [
              null,
              null,
              null,
              {{ $s.MonthlyPaymentNeedCents }} / 100
            ],
            initialDownpayment: [
              null,
              {{ $s.InitialPaymentCents }} / 100,
              null,
              null
            ],
            finalDownpayment: [
              null,
              null,
              {{ $s.FinalDownpaymentCents }} / 100,
              null
            ]
          }
        {{- end -}}
      ];
      if (!timelineSeries.length) return;

      const toMoneyTick = (v) => "$" + Number(v).toLocaleString();
      const resolveSelectedSeries = () => {
        if (!timelineHousingSelect) return timelineSeries[0];
        const selectedIndex = Number.parseInt((timelineHousingSelect.value || "0").trim(), 10);
        if (Number.isNaN(selectedIndex) || selectedIndex < 0 || selectedIndex >= timelineSeries.length) {
          return timelineSeries[0];
        }
        return timelineSeries[selectedIndex];
      };

      const initialSeries = resolveSelectedSeries();
      const initialCompactTimeline = isCompactTimeline();
      const timelineChart = new Chart(timelineCtx, {
        type: "bar",
        data: {
          labels: initialCompactTimeline ? initialSeries.compactLabels : initialSeries.labels,
          datasets: [
            {
              label: "Take-Home",
              data: initialSeries.estimatedTakeHome,
              borderColor: "#7ea13d",
              backgroundColor: "rgba(126,161,61,0.12)",
              yAxisID: "monthlyAxis",
              type: "line",
              tension: 0.22,
              spanGaps: true,
              pointRadius: 3,
              pointHoverRadius: 4,
              pointBackgroundColor: "#dcecb2",
              pointBorderColor: "#6c9429",
              pointBorderWidth: 2,
              borderWidth: 2
            },
            {
              label: "Monthly Need",
              data: initialSeries.monthlyPaymentNeed,
              backgroundColor: "rgba(138,101,69,0.72)",
              borderColor: "#8a6545",
              yAxisID: "monthlyAxis",
              type: "bar",
              borderWidth: 1,
              grouped: false,
              categoryPercentage: 0.54,
              barPercentage: 0.5,
              borderRadius: 0
            },
            {
              label: "Initial Payment",
              data: initialSeries.initialDownpayment,
              backgroundColor: "rgba(56,90,130,0.72)",
              borderColor: "#385a82",
              borderWidth: 1,
              yAxisID: "upfrontAxis",
              stack: "downpayment",
              grouped: false,
              categoryPercentage: 0.54,
              barPercentage: 0.82,
              borderRadius: 0
            },
            {
              label: "Final DP",
              data: initialSeries.finalDownpayment,
              backgroundColor: "rgba(239,127,122,0.72)",
              borderColor: "#ef7f7a",
              borderWidth: 1,
              yAxisID: "upfrontAxis",
              stack: "downpayment",
              grouped: false,
              categoryPercentage: 0.54,
              barPercentage: 0.82,
              borderRadius: 0
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: "index",
            intersect: false
          },
          plugins: {
            legend: {
              display: !initialCompactTimeline,
              position: "bottom",
              labels: {
                usePointStyle: false,
                boxWidth: initialCompactTimeline ? 18 : 42,
                padding: initialCompactTimeline ? 12 : 16,
                font: {
                  size: initialCompactTimeline ? 11 : 12
                }
              }
            }
          },
          scales: {
            x: {
              offset: true,
              ticks: {
                autoSkip: false,
                maxRotation: initialCompactTimeline ? 20 : 0,
                minRotation: initialCompactTimeline ? 20 : 0,
                font: {
                  size: initialCompactTimeline ? 10 : 12
                }
              },
              title: {
                display: !initialCompactTimeline,
                text: "Housing payment stage"
              }
            },
            monthlyAxis: {
              type: "linear",
              position: "left",
              ticks: {
                callback: toMoneyTick,
                font: {
                  size: initialCompactTimeline ? 10 : 12
                }
              },
              title: {
                display: !initialCompactTimeline,
                text: "Monthly income and payment"
              }
            },
            upfrontAxis: {
              type: "linear",
              position: "right",
              grid: {
                drawOnChartArea: false
              },
              ticks: {
                callback: toMoneyTick,
                font: {
                  size: initialCompactTimeline ? 10 : 12
                }
              },
              title: {
                display: !initialCompactTimeline,
                text: "One-time payments"
              }
            }
          }
        }
      });

      let lastCompactTimeline = initialCompactTimeline;
      const applyTimelinePresentation = () => {
        const compact = isCompactTimeline();
        const selected = resolveSelectedSeries();
        timelineChart.data.labels = compact ? selected.compactLabels : selected.labels;
        timelineChart.options.plugins.legend.display = !compact;
        timelineChart.options.plugins.legend.labels.boxWidth = compact ? 18 : 42;
        timelineChart.options.plugins.legend.labels.padding = compact ? 12 : 16;
        timelineChart.options.plugins.legend.labels.font.size = compact ? 11 : 12;
        timelineChart.options.scales.x.ticks.maxRotation = compact ? 20 : 0;
        timelineChart.options.scales.x.ticks.minRotation = compact ? 20 : 0;
        timelineChart.options.scales.x.ticks.font.size = compact ? 10 : 12;
        timelineChart.options.scales.x.title.display = !compact;
        timelineChart.options.scales.monthlyAxis.ticks.font.size = compact ? 10 : 12;
        timelineChart.options.scales.monthlyAxis.title.display = !compact;
        timelineChart.options.scales.monthlyAxis.title.text = "Monthly income and payment";
        timelineChart.options.scales.upfrontAxis.ticks.font.size = compact ? 10 : 12;
        timelineChart.options.scales.upfrontAxis.title.display = !compact;
        timelineChart.options.scales.upfrontAxis.title.text = "One-time payments";
        timelineChart.update();
        lastCompactTimeline = compact;
      };

      if (timelineHousingSelect) {
        timelineHousingSelect.addEventListener("change", () => {
          const selected = resolveSelectedSeries();
          timelineChart.data.labels = isCompactTimeline() ? selected.compactLabels : selected.labels;
          timelineChart.data.datasets[0].data = selected.estimatedTakeHome;
          timelineChart.data.datasets[1].data = selected.monthlyPaymentNeed;
          timelineChart.data.datasets[2].data = selected.initialDownpayment;
          timelineChart.data.datasets[3].data = selected.finalDownpayment;
          timelineChart.update();
        });
      }
      window.addEventListener("resize", () => {
        const compact = isCompactTimeline();
        if (compact === lastCompactTimeline) return;
        applyTimelinePresentation();
      });
    }
  })();
</script>
{{ end }}
{{ template "partials/footer" . }}
{{ end }}
