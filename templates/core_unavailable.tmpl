{{ define "core_unavailable" }}
{{ template "partials/header" . }}
<section class="card oz-panel max-w-xl mx-auto">
  <div class="card-body">
    <h1 class="card-title text-2xl">{{ .Title }}</h1>
    {{ if .Data.Logout }}
      <p>We could not confirm your logout. Please retry to securely end this session.</p>
      <form method="post" action="/logout"><button class="btn btn-primary" type="submit">Retry logout</button></form>
    {{ else }}
      <p>Please try again shortly.</p>
    {{ end }}
    {{ if .Data.Notes }}
      <p>Your unsaved notes are preserved below so you can copy them or try saving again.</p>
      {{ template "partials/housing_notes" .Data.Notes }}
    {{ end }}
    {{ if .Data.Answer }}
      <h2 class="font-semibold">Unsaved evaluation</h2>
      <p>State: {{ .Data.Answer.State }}{{ if .Data.Answer.Rating }} · Rating: {{ .Data.Answer.GetRating }}{{ end }}</p>
      <label for="evaluation-draft">Copy your unsaved evaluation notes:</label>
      <textarea id="evaluation-draft" class="textarea textarea-bordered w-full" rows="5" readonly>{{ .Data.Answer.Notes }}</textarea>
    {{ end }}
    {{ if .Data.Criterion }}
      <h2 class="font-semibold">Unsaved checklist criterion</h2>
      <p>Name: {{ .Data.Criterion.Name }}</p>
      <p>Position: {{ checklistPosition .Data.Criterion.DisplayOrder }}{{ if .Data.Criterion.Weight }} · Weight: {{ criterionWeight .Data.Criterion }}{{ end }}</p>
      <label for="criterion-draft">Copy your unsaved description:</label>
      <textarea id="criterion-draft" class="textarea textarea-bordered w-full" rows="5" readonly>{{ .Data.Criterion.Description }}</textarea>
    {{ end }}
    <div class="card-actions mt-4">
      <a class="btn btn-primary" href="/dashboard">Return to dashboard</a>
      <a class="btn btn-ghost" href="/login">Return to login</a>
    </div>
  </div>
</section>
{{ template "partials/footer" . }}
{{ end }}
